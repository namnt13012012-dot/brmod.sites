<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Khóa Của Bạn</title>
  <style>
    body { font-family: Arial; background: #050816; color: #fff; text-align: center; padding: 50px; }
    .key-box { background: #111a2f; padding: 30px; border-radius: 16px; max-width: 500px; margin: 0 auto; }
    .key-code { font-size: 22px; font-weight: bold; color: #22c55e; padding: 15px; background: #0b1220; border-radius: 8px; margin: 20px 0; }
    .btn { background: #22c55e; color: #000; padding: 10px 20px; border-radius: 6px; text-decoration: none; font-weight: bold; display: inline-block; margin-top: 10px; }
  </style>
</head>
<body>
  <div class="key-box">
    <h2>✅ Hoàn Thành!</h2>
    <p>Đây là khóa của bạn:</p>
    <div class="key-code">ABC123-XYZ789-KEY001</div>
    <a href="/" class="btn">Quay Lại Trang Chủ</a>
  </div>
</body>
</html>
